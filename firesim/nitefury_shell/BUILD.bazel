load("@rules_vivado//build/vivado:rules.bzl", "vivado_ip")

exports_files(["defs.bzl"])

# FireSim's Nitefury II shell without a block design (opt-in; see defs.bzl).
#
# The shell's cores, one per block-design cell, with the
# parameters the block design resolved for each (from its generated .xci).
# The module names are the block design's, so the board's constraints and
# Golden Gate's, which name these paths, apply unchanged.
PART = "xc7a200tfbg484-2"

# PCIe Gen2 x4 with a 128-bit AXI master for DMA and an AXI4-Lite master for control.
vivado_ip(
    name = "Top_xdma_0_0",
    config = {
        "mode_selection": "Advanced",
        "pl_link_cap_max_link_width": "X4",
        "pl_link_cap_max_link_speed": "5.0_GT/s",
        "axi_data_width": "128_bit",
        "axisten_freq": "125",
        "en_ext_ch_gt_drp": "false",
        "en_pcie_drp": "false",
        "vendor_id": "10EE",
        "pf0_device_id": "903f",
        "pf0_subsystem_vendor_id": "0",
        "pf0_subsystem_id": "0",
        "pf0_Use_Class_Code_Lookup_Assistant": "false",
        "pf0_base_class_menu": "Device_was_built_before_Class_Code_definitions_were_finalized",
        "pf0_class_code_base": "12",
        "pf0_sub_class_interface_menu": "All_currently_implemented_devices_except_VGA-compatible_devices",
        "pf0_class_code_sub": "00",
        "pf0_class_code_interface": "00",
        "axilite_master_en": "true",
        "axilite_master_size": "32",
        "axilite_master_scale": "Megabytes",
        "en_transceiver_status_ports": "false",
        "xdma_rnum_chnl": "1",
        "xdma_wnum_chnl": "1",
        "plltype": "QPLL1",
        "xdma_axi_intf_mm": "AXI_Memory_Mapped",
        "xdma_pcie_64bit_en": "true",
        "xdma_sts_ports": "false",
        "cfg_mgmt_if": "false",
        "axil_master_64bit_en": "false",
        "xdma_pcie_prefetchable": "true",
        "copy_pf0": "true",
        "PF0_DEVICE_ID_mqdma": "9024",
        "PF2_DEVICE_ID_mqdma": "9024",
        "PF3_DEVICE_ID_mqdma": "9024",
        "PF0_SRIOV_VF_DEVICE_ID": "0000",
        "enable_gen4": "false",
        "runbit_fix": "false",
    },
    part = PART,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    vlnv = "xilinx.com:ip:xdma:4.2",
)

# The FireSim host clock, 50 MHz, from the MIG user clock.
vivado_ip(
    name = "Top_clk_wiz_0_0",
    config = {
        "PRIM_IN_FREQ": "100.000",
        "CLKOUT1_REQUESTED_OUT_FREQ": "50",
        "USE_LOCKED": "false",
    },
    part = PART,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    vlnv = "xilinx.com:ip:clk_wiz:6.0",
)

# Temperature for the MIG's calibration.
vivado_ip(
    name = "Top_xadc_wiz_0_0",
    config = {
        "INTERFACE_SELECTION": "Enable_AXI",
        "DCLK_FREQUENCY": "125",
        "ADC_CONVERSION_RATE": "1000",
        "ENABLE_RESET": "false",
        "ENABLE_TEMP_BUS": "true",
    },
    part = PART,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    vlnv = "xilinx.com:ip:xadc_wiz:3.3",
)

# The host-clock reset.
vivado_ip(
    name = "Top_proc_sys_reset_0_0",
    config = {
        "C_AUX_RESET_HIGH": "0",
        "C_EXT_RESET_HIGH": "0",
    },
    part = PART,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    vlnv = "xilinx.com:ip:proc_sys_reset:5.0",
)

# The PCIe reference clock's input buffer.
vivado_ip(
    name = "Top_util_ds_buf_0",
    config = {
        "C_BUF_TYPE": "IBUFDSGTE",
    },
    part = PART,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    vlnv = "xilinx.com:ip:util_ds_buf:2.2",
)

# DMA: XDMA (125 MHz) to FireSim (host clock).
vivado_ip(
    name = "Top_axi_clock_converter_1_0",
    config = {
        "PROTOCOL": "AXI4",
        "READ_WRITE_MODE": "READ_WRITE",
        "ADDR_WIDTH": "64",
        "DATA_WIDTH": "128",
        "ID_WIDTH": "4",
        "AWUSER_WIDTH": "0",
        "ARUSER_WIDTH": "0",
        "RUSER_WIDTH": "0",
        "WUSER_WIDTH": "0",
        "BUSER_WIDTH": "0",
        "ACLK_ASYNC": "1",
        "SYNCHRONIZATION_STAGES": "8",
    },
    part = PART,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    vlnv = "xilinx.com:ip:axi_clock_converter:2.1",
)

# Control: XDMA AXI4-Lite (125 MHz) to FireSim (host clock); was axi_interconnect_0.
vivado_ip(
    name = "Top_axi_interconnect_0_imp_auto_cc_0",
    config = {
        "PROTOCOL": "AXI4LITE",
        "READ_WRITE_MODE": "READ_WRITE",
        "ADDR_WIDTH": "32",
        "DATA_WIDTH": "32",
        "ID_WIDTH": "0",
        "AWUSER_WIDTH": "0",
        "ARUSER_WIDTH": "0",
        "RUSER_WIDTH": "0",
        "WUSER_WIDTH": "0",
        "BUSER_WIDTH": "0",
        "ACLK_ASYNC": "1",
    },
    part = PART,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    vlnv = "xilinx.com:ip:axi_clock_converter:2.1",
)

# DRAM, second half of axi_interconnect_2: host clock to the MIG user clock.
vivado_ip(
    name = "Top_axi_interconnect_2_imp_auto_cc_0",
    config = {
        "PROTOCOL": "AXI4",
        "READ_WRITE_MODE": "READ_WRITE",
        "ADDR_WIDTH": "34",
        "DATA_WIDTH": "128",
        "ID_WIDTH": "0",
        "AWUSER_WIDTH": "0",
        "ARUSER_WIDTH": "0",
        "RUSER_WIDTH": "0",
        "WUSER_WIDTH": "0",
        "BUSER_WIDTH": "0",
        "ACLK_ASYNC": "1",
    },
    part = PART,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    vlnv = "xilinx.com:ip:axi_clock_converter:2.1",
)

# DRAM, first half of axi_interconnect_2: FireSim 64-bit to 128-bit.
vivado_ip(
    name = "Top_axi_interconnect_2_imp_auto_us_0",
    config = {
        "PROTOCOL": "AXI4",
        "READ_WRITE_MODE": "READ_WRITE",
        "ADDR_WIDTH": "34",
        "SI_DATA_WIDTH": "64",
        "MI_DATA_WIDTH": "128",
        "SI_ID_WIDTH": "16",
    },
    part = PART,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    vlnv = "xilinx.com:ip:axi_dwidth_converter:2.1",
)

# DDR3, from the project file the block design resolved (200 MHz input,
# 128-bit AXI, 16-bit IDs).
vivado_ip(
    name = "Top_mig_7series_0_0",
    config = {
        "XML_INPUT_FILE": "data:Top_mig_7series_0_0.prj",
        "RESET_BOARD_INTERFACE": "Custom",
        "BOARD_MIG_PARAM": "Custom",
    },
    data = [":Top_mig_7series_0_0.prj"],
    part = PART,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    vlnv = "xilinx.com:ip:mig_7series:4.2",
)

# The board files, taken from FireSim's board project (@firesim_platform_nitefury)
# as they are, or changed by a filter here; the board repository has no
# license, so none of its files are copied into this one.

# early.xdc less its PCIe lane map (four transceiver LOCs, sixteen pcie_mgt
# pins). Without a block design this file is applied after XDMA's own LOCs,
# which it can't swap; defs.bzl applies the map after synthesis instead.
genrule(
    name = "early_xdc",
    srcs = ["@firesim_platform_nitefury//:Sample-Projects/Project-0/cl_firesim/Nitefury-II/project/project.srcs/constrs_1/imports/constraints/early.xdc"],
    outs = ["early.xdc"],
    cmd = "tr -d '\\r' < $< | grep -v -E 'GTPE2_CHANNEL|pcie_mgt_' > $@",
)

# The MIG's project file as the block design resolved it (200 MHz input,
# 16-bit IDs): the board project's Top_mig_7series_0_0_1/mig_a.prj, less its
# byte-order mark and blank lines. The other copies in the project are stale.
genrule(
    name = "mig_prj",
    srcs = ["@firesim_platform_nitefury//:Sample-Projects/Project-0/cl_firesim/Nitefury-II/project/project.srcs/sources_1/bd/Top/ip/Top_mig_7series_0_0_1/mig_a.prj"],
    outs = ["Top_mig_7series_0_0.prj"],
    cmd = "sed '1s/^\\xEF\\xBB\\xBF//' $< | tr -d '\\r' | grep -v '^$$' > $@",
)

# The board's FireSim wrapper, compiled as SystemVerilog as nitefury_top.sv is.
genrule(
    name = "firesim_wrapper_sv",
    srcs = ["@firesim_platform_nitefury//:Sample-Projects/Project-0/cl_firesim/Nitefury-II/project/project.srcs/sources_1/imports/HDL/firesim_wrapper.v"],
    outs = ["firesim_wrapper.sv"],
    cmd = "cp $< $@",
)

filegroup(
    name = "board_srcs",
    srcs = [
        "nitefury_top.sv",
        ":firesim_wrapper_sv",
        "@firesim_platform_nitefury//:Sample-Projects/Project-0/cl_firesim/Nitefury-II/project/project.srcs/sources_1/imports/HDL/CodeBlinker.v",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "early",
    srcs = [":early_xdc"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "normal",
    srcs = ["@firesim_platform_nitefury//:Sample-Projects/Project-0/cl_firesim/Nitefury-II/project/project.srcs/constrs_1/imports/constraints/normal.xdc"],
    visibility = ["//visibility:public"],
)
